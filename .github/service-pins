# The PostgreSQL the CI jobs run against: server image, client tools and the key that
# signs the client's apt repository. The toolchain action reads this file; workflows and
# actions take each value from its outputs. Move the image and client together.
#
# PostgreSQL 18.7 server: postgres:18.7-trixie, multi-arch index digest.
postgres_image=postgres@sha256:2ea8630df176ad090ec92136dee850397c5af8781e4bcf2e4162593691c61bbc
# PostgreSQL 18.7 client tools (psql, pg_dump, pg_restore): PGDG package for Ubuntu 24.04.
postgres_client=18.7-1.pgdg24.04+2
# PGDG apt repository signing key, https://www.postgresql.org/media/keys/ACCC4CF8.asc
pgdg_key=B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8
