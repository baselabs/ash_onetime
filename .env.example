# Copy to .env and fill in. Never committed (.env is gitignored).

# Test-database connection. Point these values at a dedicated PostgreSQL 18
# database you already run on loopback; do not start a second database for this checkout.
# The harness accepts only ash_onetime_test under postgres or a dedicated
# ash_onetime role with CREATEDB on a non-default port; keep PGPORT and
# DATABASE_URL in sync.
PGHOST=127.0.0.1
PGPORT=18841
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=ash_onetime_test
DATABASE_URL=ecto://postgres:postgres@127.0.0.1:18841/ash_onetime_test

# Hex publishing credential (mix hex.publish reads HEX_API_KEY). Only needed
# to publish a release; never needed to build or test.
HEX_API_KEY=
