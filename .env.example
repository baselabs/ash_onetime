# Copy to .env and fill in. Never committed (.env is gitignored).

# Dedicated PostgreSQL 18: loopback, postgres user, ash_onetime_test, non-default port.
# Keep PGPORT and DATABASE_URL's port equal; source with `set -a; . ./.env; set +a`.
PGHOST=127.0.0.1
PGPORT=18841
PGUSER=postgres
PGPASSWORD=
PGDATABASE=ash_onetime_test
DATABASE_URL=ecto://${PGUSER}:${PGPASSWORD}@${PGHOST}:${PGPORT}/${PGDATABASE}
# Hostname of that throwaway server (begins "ao-"); maintenance tests read it from
# the server's /etc/hostname before any cluster-wide grant. See CONTRIBUTING.md.
ASH_ONETIME_TEST_SERVER=

# Hex publishing credential (mix hex.publish reads HEX_API_KEY). Only needed
# to publish a release; never needed to build or test.
HEX_API_KEY=
