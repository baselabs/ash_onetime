# Copy to .env and fill in. Never committed (.env is gitignored).

# Test-database substrate — `docker compose up -d` interpolates these. Pick a
# random non-standard PGPORT so the dedicated instance never collides with
# another local listener, and keep the port inside DATABASE_URL in sync with
# PGPORT. The harness (test/test_helper.exs) fails closed unless DATABASE_URL
# targets the dedicated loopback ash_onetime_test database under the postgres
# user, on any port except the default 5432. 18841 is the repo default — the
# same port CI's Linux service container publishes.
PGHOST=127.0.0.1
PGPORT=18841
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=ash_onetime_test
DATABASE_URL=ecto://postgres:postgres@127.0.0.1:18841/ash_onetime_test

# Hex publishing credential (mix hex.publish reads HEX_API_KEY). Only needed
# to publish a release; never needed to build or test.
HEX_API_KEY=
